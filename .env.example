# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings > API Keys). .env.local is never committed to git.
# Leave these empty to run the site without accounts.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
